# Long random string used to sign admin sessions. Make accounts with: npm run user -- add
QUILL_SESSION_SECRET=replace-with-64-random-characters
# Optional. Make API keys in the admin portal (API keys) instead. Keys here, comma-separated, also work.
# QUILL_API_KEYS=replace-with-a-random-key
# Where pages, settings and uploads are stored (default: ./content)
# QUILL_CONTENT_DIR=/data/content
# Optional: serve Quill under a sub-path. Needed when building, and by npm start (a Docker image keeps its build value)
# QUILL_BASE_PATH=/docs
